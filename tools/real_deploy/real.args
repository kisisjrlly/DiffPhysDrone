# ============================================================================
# DiffPhysDrone real deployment arguments
#
# 这份文件不是训练配置，而是 `tools/real_deploy/run_real_policy.py`
# 的真机启动配置。
#
# 使用方式：
#   1. 先把下面的 `--checkpoint` 改成你真实要部署的模型。
#   2. 按你的 PX4 / D455 / 任务场景修改参数。
#   3. 运行：bash tools/real_deploy/run_real.sh
#
# 额外说明：
# - 本文件支持空行、整行注释、行尾注释。
# - `run_real.sh` 会先读取本文件，再把命令行里额外传入的参数追加进去。
#   例如：
#       bash tools/real_deploy/run_real.sh --arm --auto-takeoff
#   这会临时覆盖本文件里的 `--no-arm --no-auto-takeoff`。
# - 下面默认是“安全 bring-up 模式”：
#   不自动 ARM，不自动起飞。请先完成地面联调，再切到真飞。
# ============================================================================


# ----------------------------------------------------------------------------
# 1. 必填：训练配置与 checkpoint
# ----------------------------------------------------------------------------

# 训练时使用的项目参数文件。
# 作用：
# - 决定网络结构、depth 尺寸、是否包含 camera state、是否 no_odom 等。
# - 真机脚本会按它来重建与你训练时一致的模型，然后再加载 checkpoint。
# 必须匹配训练该 checkpoint 时使用的配置；如果不匹配，轻则 load_state_dict
# 有 missing/unexpected keys，重则网络输入输出语义完全错位。
--args-file configs/paper_final_full.args

# 真机要运行的策略权重文件。
# 这是唯一必须由你手工改成真实路径的参数。
# 建议填仓库根目录下的相对路径，例如：
#   checkpoint/2026-04-23-20-10-24/checkpoint0014.pth
# run_real.sh 会检查这里是否仍然包含 `REPLACE_ME`，如果有就拒绝启动。
--checkpoint checkpoint/REPLACE_ME/checkpointXXXX.pth

# 推理设备。
# - auto: 有 CUDA 就用 CUDA，否则退回 CPU。推荐默认用这个。
# - cuda: 强制 GPU；如果 Jetson/Orin 上 CUDA 没准备好会直接报错。
# - cpu : 仅 CPU 推理，通常只适合非常保守的地面联调。
--device auto


# ----------------------------------------------------------------------------
# 2. PX4 / Offboard 链路
# ----------------------------------------------------------------------------

# pymavlink 连接串。
# 常见写法：
# - udp:127.0.0.1:14540   本机直连 PX4 SITL 或本机转发
# - udp:192.168.1.50:14540  伴随电脑通过网络连飞控侧转发
# - serial:/dev/ttyUSB0:921600 串口直连飞控
# 错填后最常见现象是：脚本一直等不到 heartbeat。
--px4-connection udp:127.0.0.1:14540

# 等待 PX4 遥测状态的超时时间。
# 这个时间过小，室内网络稍有抖动就可能误判超时。
# 这个时间过大，又会拖慢异常发现速度。
# 一般 1.0~2.0 秒比较稳。
--telemetry-timeout-s 1.0

# 真机控制回路频率。
# 推荐先与训练配置中的 `base_control_freq` 一致，避免策略看到的 dt 变化太大。
# 你当前项目常用值是 15Hz，所以这里默认写 15。
# 如果你想完全继承训练配置里的值，也可以删掉这一行。
--control-rate-hz 15.0

# PX4 offboard 下发模式。
# - accel:      只发加速度
# - vel_accel:  发速度 + 加速度前馈
# 当前脚本和你的 direct-action 策略更推荐 `vel_accel`，通常更平滑。
--px4-control-mode vel_accel

# 切入 OFFBOARD 前，先在当前位置持续发送 setpoint 的预热时间。
# 太短时，PX4 可能来不及接受稳定的 offboard setpoint 流。
# 一般 1.5~2.0 秒较稳。
--offboard-warmup-s 1.5


# ----------------------------------------------------------------------------
# 3. 安全开关：ARM / Takeoff / 收尾动作
# ----------------------------------------------------------------------------

# 是否允许脚本直接 ARM。
# 强烈建议第一阶段保持 `--no-arm`，只做“读 PX4 + 读 D455 + 跑策略 + 发指令”
# 的地面联调，确认一切正常后再改成 `--arm`。
--no-arm

# 是否在 ARM 之后自动起飞到指定高度。
# 第一阶段建议保持 `--no-auto-takeoff`。
# 如果你已经完成地面联调、Offboard 联调和安全检查，再改成 `--auto-takeoff`。
--no-auto-takeoff

# 自动起飞高度，单位米。
# 语义：相对于脚本启动后 mission 起点位置的“向上”位移。
# 只在 `--auto-takeoff` 生效时使用。
# 室内动捕环境里，推荐先用 1.0~1.5m，别一上来太高。
--takeoff-height-m 1.5

# 自动起飞判定到位的高度容差。
# 值越小，要求越严格；太小可能因为气流/估计噪声一直判不到位。
# 一般 0.10~0.15m 合适。
--takeoff-tolerance-m 0.12

# 自动起飞超时。
# 超时后脚本会抛错并进入 safe_finish。
# 室内慢速起飞 15~25s 通常足够。
--takeoff-timeout-s 20.0

# 正常结束或异常退出时的收尾动作。
# - hold   : 在当前位置短暂保持，不强行 LAND / DISARM。最保守。
# - land   : 下发 PX4 LAND，适合你已经验证过室内降落逻辑时再用。
# - disarm : 直接 DISARM，风险较高，通常只适合已落地或桨未装场景。
# 默认给 `hold`，因为它最不容易因场景未准备好而出大问题。
--finish-action hold


# ----------------------------------------------------------------------------
# 4. 任务目标定义
# ----------------------------------------------------------------------------

# 目标点在 mission frame 中，相对 mission 起点的前向位移。
# 这里的“前向”是：脚本开始任务那一刻，无人机机头朝向对应的前向。
# 如果你想先做短程验证，建议把这里先改成 2~3 米。
--goal-forward-m 5.0

# 目标点在 mission frame 中，相对 mission 起点的左向位移。
# 正值表示目标在左边，负值表示在右边。
# 如果你的真实任务是正前方直飞，这里保持 0 即可。
--goal-left-m 0.0

# 目标点在 mission frame 中，相对 mission 起点的向上位移。
# 当前室内水平穿越任务一般设 0。
# 如果你要做带高度变化的任务，才需要改它。
--goal-up-m 0.0

# 认为“到达目标”的距离阈值。
# 太小会导致飞机明明已经到位但脚本仍持续逼近；太大又会过早结束。
# 对室内小机，一般 0.25~0.40m 比较实用。
--goal-tolerance-m 0.35

# 任务最大运行时长。
# 超过这个时长后，脚本会主动退出 mission 循环并走 safe_finish。
# 当前你的训练 horizon 约 120 step @ 15Hz，再加上真实链路的缓冲，
# 这里用 30~40s 比较合理。
--mission-timeout-s 35.0


# ----------------------------------------------------------------------------
# 5. 用于构造策略状态的“部署语义”
# ----------------------------------------------------------------------------

# 这是给策略内部状态构造使用的 max_speed，不是 PX4 的硬限速参数。
# 它应该尽量与你训练该 checkpoint 时场景中的 `env.max_speed` 对齐。
# 如果这里与训练值差太大，策略看到的速度归一化语义会漂移。
# 你当前 sun_glare 分支最近调整到了 1.15 m/s，所以这里默认写 1.15。
--policy-max-speed-mps 1.15

# 这是给策略内部状态构造使用的避障 margin。
# 同样建议与训练时场景保持一致。
# 你当前常用的是 0.05m。
--policy-margin-m 0.05


# ----------------------------------------------------------------------------
# 6. D455 基础流配置
# ----------------------------------------------------------------------------

# D455 深度流宽度。
# 这是相机采集分辨率，不是送进策略的最终分辨率。
# 当前常用 640x480@30。
--d455-width 640

# D455 深度流高度。
--d455-height 480

# D455 深度流帧率。
# 太低会让控制反馈变慢；太高时 Jetson/Orin 和 USB 负载也会更大。
# 30Hz 是当前最常用也最稳的一档。
--d455-fps 30

# 指定 D455 序列号。
# 只有当你机上挂了多台 RealSense，或系统里设备枚举顺序不稳定时才需要。
# 如果只有一台 D455，保持注释状态即可。
# --d455-serial 117122250123

# 是否开启 D455 emitter。
# 对你当前这条主动深度感知链路，一般应保持开启。
# 只有在你明确想测试“关闭红外投射器”时才改成 `--no-d455-enable-emitter`。
--d455-enable-emitter


# ----------------------------------------------------------------------------
# 7. D455 语义映射：把策略输出映回真实硬件寄存器
# ----------------------------------------------------------------------------

# 曝光语义时间转 D455 微秒时的除数。
# 当前项目里 diff_depth 的 exposure_to_time 返回的是“统一语义时间”，
# 真机端通过这个除数把它缩放回 D455 的曝光寄存器量级。
# 如果你是按 recommend_d455_semantics.py 的推荐在调参数，通常保持 10000 即可。
--d455-exposure-divisor-us 10000.0

# D455 工作曝光下界，单位微秒。
# 这是“允许策略控制的真实曝光范围”的下界，而不是 D455 芯片硬件最小值。
# 推荐使用你做 D455 语义对齐时选定的工作窗口，例如 2500us。
--d455-working-exposure-min-us 2500

# D455 工作曝光上界，单位微秒。
# 推荐与语义对齐时的工作窗口一致，例如 30000us。
# 不建议一上来给到非常极端的大曝光，否则运动拖影和迟滞会明显加重。
--d455-working-exposure-max-us 30000

# D455 工作 gain 下界。
# 常见 D455 深度增益范围是 16~248。
# 这里最好与实际 probe 到的可用区间一致。
--d455-working-gain-min 16

# D455 工作 gain 上界。
# 如果你担心高 gain 噪声太重，可以把这个上界先收窄一些；
# 但它如果与训练时可用范围差太多，策略行为也可能偏。
--d455-working-gain-max 248

# D455 工作 laser power 下界。
# 当前项目里 power01 会映射到这个区间。
# 若你担心策略把 emitter 调得太低，可以把这里设成 30 或 60；
# 但若想尽量保持与训练一致，可先保留 0。
--d455-working-laser-min 0

# D455 工作 laser power 上界。
# 按你之前 probe 到的 D455 数据，常见最大值是 360。
--d455-working-laser-max 360


# ----------------------------------------------------------------------------
# 8. D455 运行时细节
# ----------------------------------------------------------------------------

# 启动 D455 后丢弃的预热帧数。
# 作用：
# - 等待曝光 / emitter / gain 设置真正稳定下来
# - 避免刚启动那几帧深度异常
# 一般 15~30 帧够用。
--camera-warmup-frames 20

# 等待一帧 D455 深度图的超时时间，单位毫秒。
# 如果 USB 链路偶发卡顿，这个值太小容易误报相机异常。
# 如果值太大，真出故障时又会等待太久。
--camera-frame-timeout-ms 1000

# 是否把 D455 深度图 resize 到训练时的 `depth_width/depth_height` 后再喂给策略。
# 当前项目训练时常用的是 64x48，因此真机部署一般应保持开启。
# 只有当你确信训练和真机输入分辨率完全一致时，才考虑关掉。
--resize-depth-to-policy


# ----------------------------------------------------------------------------
# 9. 运行日志
# ----------------------------------------------------------------------------
ls /dev/ttyUSB
# 真机运行日志目录，相对于仓库根目录。
# run_real_policy.py 会在这个目录下按时间戳创建子目录，保存：
# - meta.json
# - trace.csv
# run_real.sh 另外还会把 stdout/stderr 保存到 `logs/real_deploy/`。
--log-dir artifacts/real_policy_runs


# ----------------------------------------------------------------------------
# 10. 高级：转发给项目 parser 的 override（可选）
# ----------------------------------------------------------------------------

# `run_real_policy.py` 会把它不认识的额外参数继续传给项目自己的 config parser。
# 这给了你一个“在真机脚本侧临时覆盖训练参数”的能力。
# 但是：
# - 这也最容易让真机和训练语义悄悄失配；
# - 除非你非常明确知道自己在做什么，否则不要在这里乱改。
#
# 下面给几个示例，默认都保持注释：
#
# 示例 1：如果 checkpoint 对应的项目配置文件不是默认那个，可在这里覆盖。
# --policy_depth_mode depth
#
# 示例 2：如果你只做地面联调，想临时切成 blind 看动作输出，可以这样写：
# --policy_depth_mode zero
#
# 示例 3：如果你非常确定需要覆盖相机名义功率，可这样写：
# --cam_power_nominal 0.416667
