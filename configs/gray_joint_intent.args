# New research method; frozen legacy full/detached checkpoints stay unchanged.
--policy_arch intent_shared
--scene_layout intent_gates
--observation_grad_mode full
--camera_use_flight_intent
--intent_horizon_s 0.25
--intent_gate_spacing 2.4
--gray_temporal_samples 3
--camera_control_mode learned
--sensor_grad_mode full
--imx900_calibration configs/calibration/imx900_intent_provisional.json
--gray_saturation_mode ste
--fixed_camera_exposure 0.08
--fixed_camera_gain 0.05
--batch_size 8
--timesteps 120
--num_iters 2000
--lr 0.0001
--no-amp
--base_control_freq 15
--control_dt_jitter 0
--flight_max_speed 2.0
--max_acc_cmd 3.5
--simple_start_x -2.5
--simple_wall_x 0
--simple_goal_x 4.5
--simple_slit_half_y_min 0.36
--simple_slit_half_y_max 0.44
--simple_slit_half_y 0.4
--simple_back_wall_x_min 5.5
--simple_back_wall_x_max 5.5
--scenarios dark_to_bright bright_to_dark dark bright
--gray_width 64
--gray_height 48
--gray_nn_width 48
--gray_nn_height 36
--cam_angle 0
--gray_dark_scale 0.035
--gray_bright_scale 2.2
--gray_texture_strength 0.5
--gray_texture_scale 18
--gray_light_jitter 0.08
--coef_terminal_goal 1.0
--loss_v_window 8
--coef_d_jerk 0.02
--coef_d_acc 0.02
--coef_cam_smooth 0.005
