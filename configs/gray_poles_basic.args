# Basic visual-navigation gate, before active camera comparisons.
--policy_arch intent_shared
--scene_layout sparse_poles
--observation_grad_mode full
--gray_temporal_samples 3
--camera_control_mode fixed
--imx900_calibration configs/calibration/imx900_intent_provisional.json
--gray_saturation_mode ste
--fixed_camera_exposure 0.08
--fixed_camera_gain 0.05
--pole_count 1
--pole_radius_min 0.08
--pole_radius_max 0.12
--pole_spacing 1.5
--pole_x_jitter 0.15
--pole_lateral_range 0.48
--pole_lateral_jitter 0.12
--pole_arena_half_width 0.85
--intent_horizon_s 0.25
--batch_size 8
--timesteps 120
--num_iters 2000
--lr 0.0001
--no-amp
--base_control_freq 15
--control_dt_jitter 0
--flight_max_speed 2.0
--max_acc_cmd 3.5
--simple_start_x -2.0
--simple_wall_x 0
--simple_goal_x 5.2
--scenarios nominal
--gray_width 64
--gray_height 48
--gray_nn_width 48
--gray_nn_height 36
--cam_angle 0
--gray_texture_strength 0.5
--gray_texture_scale 18
--gray_light_jitter 0.08
--coef_terminal_goal 1.0
--loss_v_window 8
--coef_d_jerk 0.02
--coef_d_acc 0.02
--coef_cam_smooth 0.005
