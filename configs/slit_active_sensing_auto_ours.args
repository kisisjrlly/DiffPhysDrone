# Minimal active-sensing simulation benchmark

--batch_size 48
--num_iters 10000
--lr 8e-5
--grad_decay 0.3
--seed 42
--no-deterministic

--timesteps 120
--base_control_freq 15.0
--fov_x_half_tan 0.82
--cam_angle 5
--depth_width 96
--depth_height 72
--depth_min_valid 0.05
--depth_max_range 6
--depth_nn_width 64
--depth_nn_height 48
--depth_use_pipeline
--diff_sensor_impl diff_depth=cuda

--scenarios glare specular dark
--scene_layout three_wall_corridor
--corridor_scene_sequence dark specular glare
--corridor_wall_xs 0.0 2.0 4.0
--corridor_stage_release_margin 0.18
--no-corridor_shuffle_scene_order
--random_rotation
--random_rotation_max_deg 360
--simple_start_x -1.5
--simple_goal_x 4.8
--simple_wall_x 0.0
--simple_slit_center_y_min -0.75
--simple_slit_center_y_max 0.75
--simple_slit_half_y 0.15
--simple_slit_half_y_min 0.15
--simple_slit_half_y_max 0.15
--simple_slit_effect_half_z 0.75
--simple_slit_center_z 1.50
--simple_slit_side_effect_width_y 0.24
--simple_slit_side_effect_half_z 1.00
--simple_glare_halo_width_y 0.22
--simple_glare_halo_extra_half_z 0.30
--simple_glare_halo_strength 0.50
--simple_back_wall_x_min 6.00
--simple_back_wall_x_max 6.90
--simple_slit_cue_halo_width_y 0.18
--simple_slit_cue_extra_half_z 0.30
--simple_key_cue_degrade_strength 0.92
--simple_specular_false_depth_strength 0.85
--include_camera_state_in_obs
--cam_delta_max 0.05
--cam_return_rate 0.05
--max_acc_cmd 6.0

--coef_v 10.5
--loss_v_window 12
--coef_d_acc 0.05
--coef_d_jerk 0.05
--coef_obj_avoidance 0.0
--coef_collide 6.0

--cam_power_baseline 0.5
--coef_cam_smooth 0.0
--coef_diff_depth_power 100.0
--coef_diff_depth_blur 0.0
--coef_diff_depth_noise 0.0
--coef_diff_depth_fill 15.0
--diff_depth_min_fill_rate 0.9
--diff_depth_health_patch_rows 6
--diff_depth_health_patch_cols 8
--diff_depth_health_cvar_frac 0.25

--fixed_camera_power 0.50
--fixed_camera_exposure 0.50
--fixed_camera_gain 0.5
--fixed_random_power_min 0.10
--fixed_random_power_max 0.95
--fixed_random_exposure_min 0.10
--fixed_random_exposure_max 0.92
--fixed_random_gain_min 0.02
--fixed_random_gain_max 0.90

--cam_exposure_t_min 0.25
--cam_exposure_t_span 2.75
--cam_exposure_eff_min 0.25
--cam_exposure_eff_max 3.0
--cam_iso_gain_base 1.0
--cam_iso_gain_scale 0.8
--cam_iso_gain_gamma 0.6
--cam_shot_noise_base 0.01

--vis_backend rerun
--vis_env_idx 0
--vis_every_iters 10
--vis_every_steps 2
--vis_student
# --vis_enable
# --wandb_disabled
# --no-amp

# Generated by run_train_modes.sh
# mode: ours
--policy_depth_mode depth
--camera_control_mode learned
--sensor_grad_mode full
