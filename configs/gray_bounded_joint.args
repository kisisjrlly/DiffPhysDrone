# Locked standalone controller experiment; no legacy network/checkpoint.
--scene_layout single_wall_slit_diff
--policy_arch legacy
--joint_backward legacy
--grad_decay 1
--observation_grad_mode full
--pose_gradient_estimator warp_ste
--gray_temporal_samples 9
--exposure_trajectory history
--exposure_history_length 4
--camera_control_mode learned
--camera_smoothing_alpha 0
--sensor_grad_mode full
--imx900_calibration configs/calibration/grayscale_research_50ms.json
--gray_saturation_mode hard
--fixed_camera_exposure 0.015831663326653307
--fixed_camera_gain 0
--simple_start_x -1.5
--simple_wall_x 0
--simple_goal_x 1.5
--simple_slit_center_y_min -0.75
--simple_slit_center_y_max 0.75
--simple_slit_half_y 0.15
--gray_transition_x 0
--gray_transition_width 0.25
--gray_dark_scale 0.12
--gray_bright_scale 2.2
--gray_width 96
--gray_height 72
--gray_nn_width 48
--gray_nn_height 36
--cam_angle 5
--base_control_freq 15
--control_dt_jitter 0
--flight_max_speed 1.15
--max_acc_cmd 2.2
--timesteps 60
--batch_size 4
--scenarios dark bright dark_to_bright bright_to_dark
--no-amp
