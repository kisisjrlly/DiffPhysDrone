# =========================================================================
# 论文最终完整配置 (Paper Final Full Config) - 全参数对齐 main_cuda.py parser
#
# 设计目标：
# 1) 参数完整：覆盖 parser 中全部参数（便于查漏/审阅）
# 2) 论文语义：保留“为什么开这个开关”的实验意图注释
# 3) 可运行性：默认值偏向你当前实验（TBPTT + unified control + optical loss）
# =========================================================================

# ----------------- 断点恢复 (Checkpoint Resume) -----------------
# --resume /home/zhaoguodong/work/code/DiffPhysDrone/checkpoint/2026-03-10-22-18-02/checkpoint0049.pth      # 从已有权重恢复训练

# ----------------- 训练规模 (Training Scale) -----------------
--batch_size 76                      # 并行环境数（在 CAM_PROFILE=ultra + 当前GPU占用下优先保证可运行）
--num_iters 50000                   # 总迭代数
--timesteps 120                     # 每个 rollout 的物理步数

# ----------------- TBPTT + 混合调度 (Long-horizon Training) -----------------
# 目的：解决长时域 BPTT 显存压力与梯度不稳问题
# --tbptt_enable                      # 开启 TBPTT
--tbptt_chunk_steps 10              # 每 xx 步截断一次图
--tbptt_chunk_accum 1               # 每 1 个 chunk step 一次优化器
--hybrid_full_bptt_every 0         # 每 20 iter 做一次完整 BPTT 校准
--hybrid_full_bptt_batch_size 64     # 完整 BPTT 使用较小 batch 省显存

# ----------------- 优化器与数值稳定 (Optimization & Stability) -----------------
--lr 5e-5                           # AdamW 学习率
--grad_decay 0.3                    # 传给环境的梯度衰减因子
--max_acc_cmd 20.0                  # 动作/加速度限幅

# ----------------- 随机性与可复现 (Reproducibility) -----------------
--seed 42                           # 全局随机种子
# --deterministic                     # 开启确定性计算

# ----------------- 环境与相机基础参数 (Environment & Camera Base) -----------------
# 注：墙缝、地形、脚手架等属于任务场景开关，通常一次实验只开其中一类
--single                            # 单智能体模式
# --gate                            # 门穿越场景
--ground_voxels                     # 对齐原始 single_agent：复杂地形
--scaffold                        # 脚手架障碍
--random_rotation                   # 对齐原始 single_agent：场景随机旋转
--yaw_drift                         # 对齐原始 single_agent：偏航漂移噪声
# --no_odom                         # 关闭里程计输入
# --wall_slit                       # 狭缝场景

# --ellipsoid_collision               # 椭球碰撞体（更接近真实无人机外形）
--drone_a 0.15                      # 椭球 a 半轴 (x/y)
--drone_c 0.075                     # 椭球 c 半轴 (z)
--coef_tilt 0.0                     # wall_slit 侧倾损失权重（当前实现默认可设 0）

--speed_mtp 6.0                     # 对齐原始 single_agent
--fov_x_half_tan 0.82               # 对齐原始 single_agent
--base_control_freq 15.0              # 基础控制频率 (Hz)，对应控制时间步长 ctl_dt = 1/base_control_freq
--cam_angle 20                      # 对齐原始 single_agent

# ----------------- 传感器分辨率 (Sensor Resolutions) -----------------
--imx_width 120                      # 主相机宽 (从 480 降至 120，解决 OOM)
--imx_height 90                     # 主相机高 (从 360 降至 90，解决 OOM)
# --depth_width 480                   # 深度相机原始渲染宽（可微深度相机原始分辨率）
# --depth_height 270                  # 深度相机原始渲染高（可微深度相机原始分辨率）
--depth_width 32                      # 深度相机原始渲染宽（可微深度相机原始分辨率）
--depth_height 24                     # 深度相机原始渲染高（可微深度相机原始分辨率）
--depth_nn_width 4                   # 输入策略网络的深度宽（流水线最终尺寸）
--depth_nn_height 4                  # 输入策略网络的深度高（流水线最终尺寸）
--depth_use_pipeline                  # 深度输入启用图像处理流水线（diff_depth 与 camera_luma_plus_depth 均生效）
# --no-depth_use_pipeline             # 关闭流水线，按各模式的直输逻辑输入网络
# --diff_sensor_impl camera_luma=cuda diff_depth=cuda
--diff_sensor_impl camera_luma=cuda diff_depth=cuda

# 已弃用（仅保留对照）：策略融合输入尺寸，当前代码会给 warning
# --policy_input_width 80
# --policy_input_height 60

# ----------------- 主损失权重 (Core Physical Losses) -----------------
# 速度相关区别：
# - coef_v      : 向量级主目标（方向+大小）
# - coef_v_pred : 监督网络的速度预测头（表征辅助）
--coef_v 3.0                        # 速度向量跟踪主损失
--coef_v_pred 0.0                   # 速度预测头监督损失

--coef_d_acc 0.01                   # 动作能量/加速度正则
--coef_d_jerk 0.001                 # jerk 正则

--coef_obj_avoidance 2.0            # 避障势能惩罚
--coef_collide 7.5                  # 对齐原始 single_agent
--coef_ground_affinity 0.0          # 地面亲和损失权重（遗留）

# ----------------- 可微相机 + 主动感知 (Differentiable Camera) -----------------
# Paper §2.1 + §2.3
# 典型组合：include_camera_state_in_obs + enable_camera_quality_loss
--include_camera_state_in_obs       # 观测中加入当前相机参数

--coef_cam_smooth 0.01              # 相机参数时域平滑
--coef_fov_reg 0.005                # FOV 回归中心正则
--coef_cam_range 0.001              # 相机参数范围正则

# 高保真可微相机渲染档位与开关（7层管线）
--cam_realism_preset low           # low / medium / high / ultra
--cam_enable_shadow                 # 阴影近似
--cam_enable_specular               # 镜面反射
--cam_enable_distortion             # 镜头径向畸变
--cam_enable_flare                # 光照强度缩放
--cam_ae_target 0.36                # 自动曝光目标亮度

# 论文光学势能 (Optical Perception Potentials)
# - coef_blur: 惩罚高速+长曝光+长焦导致的运动模糊
# - coef_noise: 惩罚高 ISO /          # flare 近似
--cam_enable_motion_blur            # 时序运动模糊
--cam_enable_rolling                # rolling shutter 混合
--cam_noise_scale 1.0               # 传感器噪声强度缩放
--cam_blur_scale 1.0                # 运动模糊强度缩放
--cam_fog_scale 1.0                 # 大气散射/雾强度缩放
--cam_lighting_scale 1.0            # 光照强度缩放
--cam_ae_target 0.36                # 自动曝光目标亮度

# 相机语义映射常数（统一管理）
--cam_exposure_t_min 0.25
--cam_exposure_t_span 2.75
--cam_exposure_eff_min 0.15
--cam_exposure_eff_max 4.0
--cam_iso_gain_base 1.0
--cam_iso_gain_scale 10.0
--cam_iso_gain_gamma 1.2
--cam_shot_noise_base 0.03

# 论文光学势能 (Optical Perception Potentials)
# - coef_blur: 惩罚高速+长曝光+长焦导致的运动模糊
# - coef_noise: 惩罚高 ISO / 低曝光条件下的噪声放大
--enable_camera_quality_loss        # 开启 blur/noise 光学损失
--coef_blur 0.03                     # 运动模糊损失权重
--coef_noise 0.02                   # 噪声损失权重

# ----------------- 教师-学生训练 (Paper §3) -----------------
# 当前代码逻辑：若 tbptt_enable 与 enable_teacher_student_training 同时开，会提示复杂度风险并优先完整 BPTT 路径
# 注意：当前代码中 TBPTT 与 enable_teacher_student_training 同时开会触发 warning，优先走完整 BPTT 路径
# --enable_teacher_student_training    # 是否启用教师-学生训练
--teacher_inner_steps 10             # 教师内循环步数
--teacher_inner_lr 0.005             # 教师内循环学习率
--distill_coef 1.0                  # 蒸馏损失权重
--student_physics_coef 0.6          # 蒸馏模式下物理损失权重
--teacher_tbptt_chunk_steps 10      # 教师 TBPTT 截断步数（当前实现默认与主训练一致）
--distill_final_ratio 0.5           # 蒸馏权重退火终点比例（相对 coef_distill，早高晚低）
--student_noise_mode off            # 蒸馏阶段 student 前向是否加噪声：off=关闭, on=开启

# ----------------- 传感模式 + 控制架构 (Sensor & Control) -----------------
--sensor_mode camera_luma_plus_depth #（主视觉 + 深度）
# --sensor_mode camera_luma  # depth / camera_luma / camera_luma_plus_depth / diff_depth

# dMPC/dLQR 相关：
# 只有 use_dmpc + policy_output_intent 同时开启时，才走意图域 LQR 路径
# 当前你若只开 policy_output_intent 会回退动作域（代码会 warning）
# --use_dmpc
--policy_direct_action             # 与 policy_output_intent 互斥
# --policy_output_intent              # 策略输出意图向量（速度参考 + 代价权重参数）
# --inject_depth_into_lqr           # 仅 use_dmpc 时生效；当前 direct_action 配置下关闭以避免歧义
--lqr_horizon 5                     # dLQR 有限时域长度（前瞻步数）
--lqr_reg 1e-3                      # Riccati 求解正则项，防止病态矩阵
--depth_safe_dist 0.6               # 深度安全距离阈值（米）
--depth_repel_gain 1.0              # 安全距离内的排斥增益系数

# 深度输入通道配置
# 当前实现仅使用深度通道，不再提供 confidence 通道开关。

# 已弃用（保留对照）：
# --dual_encoder                    # 代码会 warning：结构由 sensor_mode 自动决定

# ----------------- 可视化与日志 (Visualization & Logging) -----------------
# 可视化会影响训练吞吐；做长跑实验时可适当降低采样频率
# --vis_enable                      # 关闭可视化以节省显存/提升吞吐；需要观测时再临时开启
--vis_backend rerun                 # 可视化后端（当前支持 rerun）
--vis_env_idx 0                     # 可视化的环境索引（batch 内第几个）
--vis_every_iters 10                # 每多少个迭代记录一次可视化
--vis_every_steps 10                # 单次迭代内每多少步采样一次可视化
--vis_teacher                       # 在教师-学生训练时显示 Teacher 轨迹
--vis_student                       # 显示 Student 执行轨迹
--vis_spawn                         # 自动拉起可视化窗口

# WandB
# --wandb_disabled                  # 关闭在线日志
# --no-amp                           # 对齐原始项目：关闭混合精度