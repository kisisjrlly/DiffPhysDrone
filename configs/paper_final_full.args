# =========================================================================
# Fixed small-map perception-scenario config for diff_depth
#
# 目标：
# 1) 使用固定 10m x 10m 小地图与简单几何，降低复杂避障难度
# 2) 保留 scenarios，用于训练/测试可微感知调参能力
# 3) 不回退到旧的大地图随机世界
# =========================================================================

# ----------------- Training scale -----------------
--batch_size 96
--num_iters 5000
--timesteps 120

# ----------------- TBPTT / schedule -----------------
# --tbptt_enable
--tbptt_chunk_steps 10
--tbptt_chunk_accum 1
--hybrid_full_bptt_every 0
--hybrid_full_bptt_batch_size 64

# ----------------- Optimization -----------------
--lr 5e-5
--grad_decay 0.3
--max_acc_cmd 2.0

# ----------------- Reproducibility -----------------
--seed 42
# --deterministic

# ----------------- Fixed small-map environment -----------------
--fov_x_half_tan 0.82
--base_control_freq 15.0
--cam_angle 20
# --yaw_drift
# --no_odom
# --scenarios base sun_glare specular_trap vantablack_gap dark_morphing
--scenarios sun_glare
--scene_fit_profiles_path configs/scene_fit_profiles.json

# --ellipsoid_collision
--drone_a 0.15
--drone_c 0.075
--coef_tilt 0.0

# ----------------- Depth input -----------------
--depth_width 64
--depth_height 48
--depth_min_valid 0.3
--depth_max_range 6.0
--depth_nn_width 32
--depth_nn_height 24
--depth_use_pipeline
--diff_sensor_impl diff_depth=python

# ----------------- Core losses -----------------
--coef_v 5.5
--loss_v_window 12
--coef_v_pred 0.0
--coef_d_acc 0.1
--coef_d_jerk 0.2
--coef_obj_avoidance 0.5
--coef_collide 10.0
--coef_ground_affinity 0.0

# ----------------- Active sensing -----------------
--include_camera_state_in_obs
--coef_cam_smooth 100
--coef_power_reg 100
--cam_power_reg_deadband 0.18
--coef_cam_range 1

--cam_realism_preset low
--cam_enable_specular
--cam_enable_motion_blur
--cam_noise_scale 1.0
--cam_blur_scale 1.0
--cam_fog_scale 1.0
--cam_lighting_scale 1.0
--cam_model_randomize
--cam_model_randomize_scale 0.08
--cam_power_nominal 0.416667
--cam_power_penalty_threshold 0.416667

--cam_exposure_t_min 0.25
--cam_exposure_t_span 2.75
--cam_exposure_eff_min 0.25
--cam_exposure_eff_max 3.0
--cam_iso_gain_base 1.0
--cam_iso_gain_scale 10.0
--cam_iso_gain_gamma 1.2
--cam_shot_noise_base 0.03

--coef_diff_depth_power 20
--coef_diff_depth_blur 0.05
--coef_diff_depth_noise 5
--coef_diff_depth_fill 5.0
--diff_depth_min_fill_rate 0.25
--coef_sun_glare_local_quality 30.0
--sun_glare_local_quality_target 0.20

# ----------------- Teacher-student -----------------
# --enable_teacher_student_training
--teacher_inner_steps 10
--teacher_inner_lr 0.005
--distill_coef 1.0
--student_physics_coef 0.6
--teacher_tbptt_chunk_steps 10
--distill_final_ratio 0.5
--student_noise_mode off

# ----------------- Control architecture -----------------
# --use_dmpc
# --policy_output_intent
# --inject_depth_into_lqr
--lqr_horizon 5
--lqr_reg 1e-3
--depth_safe_dist 0.6
--depth_repel_gain 1.0

# ----------------- Visualization / logging -----------------
# --vis_enable
--vis_backend rerun
--vis_env_idx 0
--vis_every_iters 10
--vis_every_steps 10
--vis_teacher
--vis_student
# --vis_spawn

# --wandb_disabled
# --wandb_log_raw_loss_terms
# --no-amp
