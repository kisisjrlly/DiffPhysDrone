# 2026-11-05 locked learning round; geometry/radiometry match gray_joint_slit.
--scene_layout joint_slit
--policy_arch intent_shared
--joint_backward consistent
--grad_decay 1
--observation_grad_mode full
--pose_gradient_estimator warp_ste
--camera_queue_aligned_intent
--gray_temporal_samples 9
--camera_control_mode mean_ae
--train_flight_only
--imx900_calibration configs/calibration/imx900_provisional.json
--gray_saturation_mode ste
--fixed_camera_exposure 0.10
--fixed_camera_gain 0.02
--simple_start_x -2.5
--simple_wall_x 0
--simple_goal_x 1.5
--simple_slit_half_y 0.15
--gray_transition_x -0.65
--gray_transition_width 0.25
--gray_dark_scale 0.12
--gray_bright_scale 2.2
--gray_width 96
--gray_height 72
--gray_nn_width 48
--gray_nn_height 36
--cam_angle 5
--base_control_freq 15
--control_dt_jitter 0
--flight_max_speed 1.15
--max_acc_cmd 2.2
--timesteps 90
--batch_size 4
--loss_v_window 12
--scenarios dark bright dark_to_bright bright_to_dark
--no-amp
--coef_v 0
--coef_collide 6
--coef_obj_avoidance 0
--coef_d_acc 0.05
--coef_d_jerk 0.05
--coef_cam_smooth 0
--coef_terminal_goal 10
--seed 42
--num_iters 2000
--lr 0.0003
--wandb_disabled
