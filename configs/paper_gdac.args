# Environment
--single
--wall_slit
--ellipsoid_collision
--drone_a 0.15
--drone_c 0.075
--speed_mtp 0.5

# Core losses
--coef_collide 10.0
--coef_obj_avoidance 5.0

# Training
--timesteps 120

# Camera control + camera-quality setup
--include_camera_state_in_obs
--enable_camera_quality_loss

# Teacher-student training
--enable_teacher_student_training
--teacher_inner_steps 10
--teacher_inner_lr 0.01
--distill_coef 1.0
--student_physics_coef 0.3

# Optical loss weights
--coef_blur 0.1
--coef_noise 0.05

--coef_cam_smooth 0.01
--coef_fov_reg 0.005
--coef_cam_range 0.001

# Camera semantic mapping constants
--cam_exposure_t_min 0.25
--cam_exposure_t_span 2.75
--cam_exposure_eff_min 0.15
--cam_exposure_eff_max 4.0
--cam_iso_gain_base 1.0
--cam_iso_gain_scale 10.0
--cam_iso_gain_gamma 1.2
--cam_shot_noise_base 0.03

# Logging
--wandb_disabled
