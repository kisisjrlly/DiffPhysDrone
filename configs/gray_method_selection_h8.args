# Same parallax task and forward images; optional image-warp pose backward.
# Two-pole depth ambiguity development. No privileged sensing or camera labels.
--pole_layout parallax_pair
--pole_pair_near_depth 1.0
--pole_pair_far_depth 1.8
--pole_pair_depth_jitter 0.05
--pole_pair_bearing 0.10
--pole_pair_angular_radius 0.06
--camera_lr_multiplier 20
--policy_arch intent_shared
--scene_layout sparse_poles
--observation_grad_mode full
--camera_use_flight_intent
