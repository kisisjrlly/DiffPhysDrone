--pole_spacing 1.5
--pole_x_jitter 0.15
--pole_lateral_range 0.48
--pole_lateral_jitter 0.12
--pole_arena_half_width 0.38
--batch_size 8
--timesteps 120
--num_iters 2000
--lr 0.0001
--no-amp
--base_control_freq 15
--control_dt_jitter 0
