# Matched sensor-gradient ablation. Same frozen flight/camera architecture, but E/G are detached before image formation.
--camera_control_mode learned
--sensor_grad_mode detached
--policy_gray_mode gray
--train_camera_only
--scenarios dark bright dark_to_bright bright_to_dark
--batch_size 64
--num_iters 3000
--lr 8e-5
--grad_decay 0.3
--seed 42
--no-deterministic

--timesteps 60
--base_control_freq 15.0
--fov_x_half_tan 0.82
--cam_angle 5

--gray_width 96
--gray_height 72
--gray_nn_width 48
--gray_nn_height 36

--simple_start_x -1.5
--simple_goal_x 1.5
--simple_wall_x 0.0
--simple_slit_center_y_min -0.75
--simple_slit_center_y_max 0.75
--simple_slit_half_y 0.15
--simple_slit_half_y_min 0.15
--simple_slit_half_y_max 0.15
--simple_slit_center_z 1.50
--simple_back_wall_x_min 2.0
--simple_back_wall_x_max 2.85

--no-include_camera_state_in_obs
--max_acc_cmd 2.2

--gray_nominal_ambient 0.18
--gray_nominal_diffuse 0.72
--gray_dark_scale 0.12
--gray_bright_scale 2.2
--gray_background_intensity 0.04
--gray_transition_x 0.0
--gray_transition_width 0.25
--gray_light_jitter 0.08
--gray_texture_strength 0.35
--gray_texture_scale 5.0

--imx900_calibration configs/calibration/imx900_provisional.json
--gray_blur_kernel_size 5
--gray_motion_depth_floor 0.35
--gray_dark_threshold 0.05
--gray_saturation_mode soft
--gray_soft_clip_beta 12.0
--gray_enable_noise

--fixed_camera_exposure 0.35
--fixed_camera_gain 0.15
--fixed_random_exposure_min 0.10
--fixed_random_exposure_max 0.90
--fixed_random_gain_min 0.02
--fixed_random_gain_max 0.90
--camera_ema_alpha 0.7

--coef_v 10.5
--loss_v_window 12
--coef_d_acc 0.05
--coef_d_jerk 0.05
--coef_obj_avoidance 0.0
--coef_collide 6.0
--coef_cam_smooth 0.005

--vis_backend rerun
--vis_env_idx 0
--vis_every_iters 10
--vis_every_steps 2
--vis_student
