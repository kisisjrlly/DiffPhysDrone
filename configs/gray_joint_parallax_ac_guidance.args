# Opt-in short-horizon actor-critic pilot on the existing, unchanged scene.
# Same 200,605-parameter actor and common flight-only warm start in both arms.
--policy_arch intent_shared
--scene_layout sparse_poles
--pole_layout parallax_pair
--pole_count 2
--pole_pair_near_depth 2.5
--pole_pair_far_depth 4.5
--pole_pair_depth_jitter 0.05
--pole_pair_bearing 0.04
--pole_pair_angular_radius 0.024
--pole_arena_half_width 0.38
--fov_x_half_tan 0.328
--simple_start_x -2.0
--simple_goal_x 4.2
--camera_use_flight_intent
--intent_horizon_s 0.25
--gray_temporal_samples 3
--camera_control_mode learned
--sensor_grad_mode full
--observation_grad_mode full
--pose_gradient_estimator warp_ste
--joint_backward consistent
--grad_decay 1
--imx900_calibration configs/calibration/imx900_intent_provisional.json
--gray_saturation_mode ste
--fixed_camera_exposure 0.08
--fixed_camera_gain 0.05
--policy_update_mode short_horizon_ac
--policy_gradient_horizon 16
--policy_return_gamma 0.99
--camera_exploration_std 0.25
--critic_lr_multiplier 100
--camera_lr_multiplier 1
--batch_size 4
--timesteps 120
--num_iters 20
--lr 0.00001
--no-amp
--base_control_freq 15
--control_dt_jitter 0
--flight_max_speed 2.0
--max_acc_cmd 3.5
--scenarios nominal
--gray_width 64
--gray_height 48
--gray_nn_width 48
--gray_nn_height 36
--cam_angle 0
--gray_texture_strength 0
--gray_texture_scale 18
--gray_light_jitter 0.08
--coef_terminal_goal 1.0
--loss_v_window 8
--coef_d_jerk 0.02
--coef_d_acc 0.02
--coef_cam_smooth 0.005
--flight_replay_dataset logs/sparse_poles_iteration_20261021/parallax_lookahead_flight_imitation_v1/flight_dataset.pt
--flight_replay_weight 1000
--flight_replay_batch 4
--resume logs/sparse_poles_iteration_20261021/parallax_lookahead_flight_imitation_v1/final.pth
--live_flight_guidance_weight 10.0
--live_flight_guidance_start_step 24
--live_flight_guidance_margin 0.08
