# Environment
--single
--wall_slit
--ellipsoid_collision
--drone_a 0.15
--drone_c 0.075
--speed_mtp 0.5

# Training
--timesteps 120
--batch_size 64
--num_iters 50000

# Core losses
--coef_collide 10.0
--coef_obj_avoidance 5.0

# Paper setup
--paper_unified_control
--paper_cam_obs
--paper_optical_loss

# Ablation: RGB only + direct policy action
--vision_mode=yuv
--policy_direct_action

# Optical loss weights
--coef_cam_smooth 0.01
--coef_fov_reg 0.005
--coef_cam_range 0.001
--coef_blur 0.1
--coef_noise 0.05


# Logging
--wandb_disabled
