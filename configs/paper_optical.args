# Environment
--single
--speed_mtp 4
--ground_voxels
--random_rotation
--yaw_drift

# Core losses
--coef_collide 7.5
--coef_obj_avoidance 3.0

# Camera
--cam_angle 20
--fov_x_half_tan 0.82

# Camera quality losses
--enable_camera_quality_loss
--coef_blur 0.1
--coef_noise 0.05

# Camera semantic mapping constants
--cam_exposure_t_min 0.25
--cam_exposure_t_span 2.75
--cam_exposure_eff_min 0.15
--cam_exposure_eff_max 4.0
--cam_iso_gain_base 1.0
--cam_iso_gain_scale 10.0
--cam_iso_gain_gamma 1.2
--cam_shot_noise_base 0.03

--coef_cam_smooth 0.01
--coef_fov_reg 0.005
--coef_cam_range 0.001
