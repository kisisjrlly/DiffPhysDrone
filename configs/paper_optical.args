# Environment
--single
--speed_mtp 4
--ground_voxels
--random_rotation
--yaw_drift

# Core losses
--coef_collide 7.5
--coef_obj_avoidance 3.0

# Camera
--cam_angle 20
--fov_x_half_tan 0.82
--camera_action_mode absolute

# Camera quality losses
--enable_camera_quality_loss
--coef_blur 0.1
--coef_noise 0.05

--coef_cam_smooth 0.01
--coef_fov_reg 0.005
--coef_cam_range 0.001
