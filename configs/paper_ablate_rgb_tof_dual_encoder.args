# Environment
--single
--wall_slit
--ellipsoid_collision
--drone_a 0.15
--drone_c 0.075
--speed_mtp 0.5

# Training
--timesteps 120
--batch_size 64
--num_iters 50000

# Core losses
--coef_collide 10.0
--coef_obj_avoidance 5.0

# Camera incremental control + camera-quality setup
--camera_action_mode incremental
--include_camera_state_in_obs
--enable_camera_quality_loss

# Ablation: camera_luma+passive_depth + intent dLQR
--sensor_mode=camera_luma_plus_passive_depth
--dual_encoder
--use_dmpc
--policy_output_intent
--inject_tof_into_lqr
--lqr_horizon 5
--lqr_reg 1e-4
--tof_safe_dist 0.6
--tof_repel_gain 1.0

# Optical loss weights
--coef_cam_smooth 0.01
--coef_fov_reg 0.005
--coef_cam_range 0.001
--coef_blur 0.1
--coef_noise 0.05


# Logging
--wandb_disabled
