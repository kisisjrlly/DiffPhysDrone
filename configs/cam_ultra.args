# ==========================================================
# Camera Profile: ULTRA
# 目标：最大化视觉域差异覆盖（更强噪声/模糊/光照变化）
# 建议：用于后期短程微调，不建议从头全程使用
# 用法：TASK=slit_active_sensing CAM_PROFILE=ultra bash run.sh
# ==========================================================

--cam_realism_preset ultra
--cam_enable_specular
--cam_enable_motion_blur

--cam_noise_scale 1.25
--cam_blur_scale 1.2
--cam_fog_scale 1.15
--cam_lighting_scale 1.05

# Camera semantic mapping constants
--cam_exposure_t_min 0.25
--cam_exposure_t_span 2.75
--cam_exposure_eff_min 0.15
--cam_exposure_eff_max 4.0
--cam_iso_gain_base 1.0
--cam_iso_gain_scale 10.0
--cam_iso_gain_gamma 1.2
--cam_shot_noise_base 0.03
